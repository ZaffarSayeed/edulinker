sitemap = '<?xml version="1.0" encoding="UTF-8"?>'
    sitemap += '<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">'

    for page in pages:
        sitemap += f'''
        <url>
            <loc>{page}</loc>
        </url>
        '''

    sitemap += '</urlset>'

    return Response(sitemap, mimetype='application/xml')